# Sao chép file này thành .env rồi điền. Không commit .env.

# Token gói Claude: chạy `claude setup-token` rồi dán vào đây. Mọi lượt gọi AI đi qua Claude Code (`claude -p`).
CLAUDE_CODE_OAUTH_TOKEN=
# "api" để trang tự chạy hội đồng; "viewer" chỉ phát lại hội đồng chạy bằng /roast-room trong Claude Code.
COUNCIL_RUNNER=api

# Tuỳ chọn: thư mục ghi chú của bạn để Chủ toạ đọc (chỉ đọc) và kiểm số liệu. Bỏ trống thì không đọc tài liệu.
TAI_LIEU_DIR=
# Tuỳ chọn: nơi ghi phiếu quyết định (mặc định phieu/ trong repo).
PHIEU_DIR=

# Tuỳ chọn: model và mức suy nghĩ (low|medium|high|xhigh|max).
# SEAT_MODEL=claude-sonnet-5-5
# CHAIR_MODEL=claude-opus-5-5
# COUNCIL_EFFORT=xhigh
# HOI_EFFORT=medium
# DOC_EFFORT=xhigh
# HOI_BRAIN=nho
# CHAIR_SEAT=musk
# CHAIR_VIEW_TIMEOUT_MS=300000

# Thay cho token gói: khoá API Anthropic (tính tiền theo lượt gọi). Chỉ dùng cho phần hội đồng; vòng hỏi gốc
# và đọc tài liệu vẫn cần CLAUDE_CODE_OAUTH_TOKEN.
ANTHROPIC_API_KEY=

# /newroaster dùng để vẽ chân dung cho cố vấn mới (khoảng 5 lượt tạo ảnh). Lấy khoá ở https://kie.ai/api-key
KIE_AI_API_KEY=
